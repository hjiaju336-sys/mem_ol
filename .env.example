# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=<your-api-key>
# 示例；按业务空间实际可用模型修改
OPENAI_MODEL=qwen-plus

EMBEDDING_MODEL_PATH=./models/bge-large-zh-v1.5
EMBEDDING_DIM=1024

POSTGRES_DSN=postgresql://mem_ol:mem_ol@localhost:55432/mem_ol
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=mem_ol_dev

MEMORY_BATCH_TURNS=5
DIALOGUE_TIMEOUT=120
WORLD_EXTRACT_WINDOW_CHARS=20000
WORLD_EXTRACT_TIMEOUT=240
WORLD_EXTRACT_WORKERS=6
WORLD_CONSOLIDATE_MAX_CHARS=30000
PLOT_ARC_SIZE=5
PLOT_RECALL_TOP_K=3
PLOT_RECALL_MIN_SCORE=0.3
RERANK_MODEL_PATH=D:/RAGPRO/rag-pro/rag_system/models/BAAI/bge-reranker-v2-m3
ENTITY_WEIGHT=0.6
CONTEXT_WEIGHT=0.4
CHECKPOINT_RETENTION_TURNS=5
LOG_LEVEL=INFO
LOG_FILE=logs/mem_ol.log
